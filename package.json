{
  "name": "ambitious-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:contract": "node scripts/check-envelope-examples.mjs",
    "check:standalone": "node scripts/check-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\" \"packages/*/test/*.test.ts\" \"scripts/*.test.mjs\"",
    "lint": "eslint . && ambitious-standalone",
    "depcruise": "depcruise src packages scripts --output-type err-long",
    "tlc": "node scripts/tlc.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.15.0",
    "typescript": "6.0.3"
  }
}
