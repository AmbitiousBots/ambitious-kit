{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ambitious module output envelope, version 1",
  "description": "The single JSON document every ambitious-<module> command writes to stdout, on success and on error. MODULE_CONTRACT.md rule 1 explains each field; examples are in examples/envelopes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "schemaVersion", "module", "command", "data", "errors", "meta"],
  "properties": {
    "ok": { "type": "boolean" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "module": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "command": { "type": "string", "pattern": "^([a-z][a-z0-9-]*( [a-z][a-z0-9-]*)*)?$" },
    "data": { "type": "object" },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } },
    "meta": { "$ref": "#/$defs/meta" }
  },
  "if": { "required": ["ok"], "properties": { "ok": { "const": true } } },
  "then": { "properties": { "errors": { "maxItems": 0 } } },
  "else": { "properties": { "errors": { "minItems": 1 } } },
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "hint"],
      "properties": {
        "code": { "type": "string", "pattern": "^E_[A-Z0-9]+(_[A-Z0-9]+)*$" },
        "message": { "type": "string", "minLength": 1 },
        "hint": { "type": "string", "minLength": 1 }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["now", "seed", "version"],
      "properties": {
        "now": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$" }
      }
    }
  }
}
